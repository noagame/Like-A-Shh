NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_FORMSPREE_URL=https://formspree.io/f/your-form
# Alertas de nuevas inscripciones. Nunca expongas el token con prefijo NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
TELEGRAM_ADMIN_CHAT_ID=replace-with-admin-chat-id
# Opcional: si el profesor usa otro chat, también recibe la alerta.
TELEGRAM_PROFESSOR_CHAT_ID=replace-with-professor-chat-id
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token
# Set only to a SINGLE IP header overwritten by your trusted ingress.
# If absent, requests share a conservative global IP limit plus the account limit.
# TRUSTED_CLIENT_IP_HEADER=x-real-ip
